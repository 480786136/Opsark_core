[
  {"name":"state query", "command":"firewall-cmd --state", "readonly":true, "mutation":null},
  {"name":"permanent port query", "command":"firewall-cmd --permanent --query-port=8081/tcp", "readonly":true, "mutation":null},
  {"name":"separate port argument", "command":"firewall-cmd --query-port 8081/tcp --zone public", "readonly":true, "mutation":null},
  {"name":"quoted zone selector", "command":"firewall-cmd --zone='public' --list-all", "readonly":true, "mutation":null},
  {"name":"absolute standard executable", "command":"/usr/bin/firewall-cmd --list-all-zones", "readonly":true, "mutation":null},
  {"name":"sudo query", "command":"sudo -n firewall-cmd --get-active-zones", "readonly":true, "mutation":null},
  {"name":"permanent and runtime query", "command":"set -o pipefail\nfirewall-cmd --permanent --query-port=8081/tcp && firewall-cmd --query-port=8081/tcp", "readonly":true, "mutation":null},
  {"name":"strict shell query", "command":"set -euo pipefail; firewall-cmd --permanent --query-port=8081/tcp; firewall-cmd --query-port=8081/tcp", "readonly":true, "mutation":null},
  {"name":"query capture and receipt", "command":"out=$(firewall-cmd --permanent --query-port=8081/tcp 2>&1); rc=$?; printf '%s\\n' \"$out\"; exit \"$rc\"", "readonly":true, "mutation":null},
  {"name":"two captures and acceptance", "command":"permanent=$(firewall-cmd --permanent --query-port=8081/tcp); runtime=$(firewall-cmd --query-port=8081/tcp); test \"$permanent\" = yes && test \"$runtime\" = yes", "readonly":true, "mutation":null},
  {"name":"conditional query", "command":"if firewall-cmd --permanent --query-port=8081/tcp; then echo permanent=yes; else echo permanent=no; exit 1; fi", "readonly":true, "mutation":null},
  {"name":"conditional capture checks", "command":"permanent=$(firewall-cmd --permanent --query-port=8081/tcp); if [ \"$permanent\" = yes ]; then echo ok; else exit 1; fi", "readonly":true, "mutation":null},
  {"name":"nested query capture", "command":"out=$(printf '%s' \"$(firewall-cmd --query-port=8081/tcp)\"); echo \"$out\"", "readonly":true, "mutation":null},
  {"name":"query with comment", "command":"firewall-cmd --list-ports # firewall-cmd --reload\nfirewall-cmd --list-services", "readonly":true, "mutation":null},
  {"name":"literal mutation text is data", "command":"firewall-cmd --state; printf '%s' 'firewall-cmd --reload'", "readonly":true, "mutation":null},
  {"name":"query and add in same invocation", "command":"firewall-cmd --query-port=8081/tcp --add-port=8081/tcp", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"query followed by reload", "command":"firewall-cmd --query-port=8081/tcp && firewall-cmd --reload", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"query followed by remove", "command":"firewall-cmd --list-ports; firewall-cmd --permanent --remove-port=8081/tcp", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"conditional add", "command":"if firewall-cmd --query-port=8081/tcp; then echo yes; else firewall-cmd --add-port=8081/tcp; fi", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"query plus unknown option", "command":"firewall-cmd --state --future-flag", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"unknown list option", "command":"firewall-cmd --list-and-reload", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"unknown zone value", "command":"firewall-cmd --query-port=8081/tcp --zone --reload", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"unknown query value", "command":"firewall-cmd --query-port=8081/tcp,8082/tcp", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"empty invocation", "command":"firewall-cmd --permanent", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"computed action", "command":"action=--reload; firewall-cmd \"$action\"", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"substitution mixes reload", "command":"out=$(firewall-cmd --query-port=8081/tcp; firewall-cmd --reload); echo \"$out\"", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"query argument substitution writes", "command":"firewall-cmd --query-port=\"$(firewall-cmd --add-port=8081/tcp)\"", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"nested quoted mutation", "command":"firewall-cmd --state; echo \"$(printf '%s' \"$(firewall-cmd --reload)\")\"", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"backtick mutation", "command":"firewall-cmd --state; echo `firewall-cmd --reload`", "readonly":false, "mutation":"firewall-cmd"},
  {"name":"unsafe output redirect", "command":"firewall-cmd --list-all > /etc/firewalld/zones/public.xml", "readonly":false, "mutation":">"},
  {"name":"query piped to interpreter", "command":"firewall-cmd --list-all | sh", "readonly":false, "mutation":"sh"},
  {"name":"opaque evaluator", "command":"firewall-cmd --state; eval \"$next\"", "readonly":false, "mutation":"eval"},
  {"name":"unknown executable", "command":"firewall-cmd --state; apply-firewall-policy", "readonly":false, "mutation":null},
  {"name":"background query not exempted", "command":"firewall-cmd --state &", "readonly":false, "mutation":null},
  {"name":"environment prefix not exempted", "command":"PYTHONPATH=/tmp/firewall-override firewall-cmd --state", "readonly":false, "mutation":null},
  {"name":"environment setup not exempted", "command":"PATH=/tmp:$PATH; firewall-cmd --state", "readonly":false, "mutation":null},
  {"name":"parameter expansion not exempted", "command":"firewall-cmd --state; echo \"${next:=unknown}\"", "readonly":false, "mutation":null},
  {"name":"arithmetic expansion not exempted", "command":"firewall-cmd --state; echo $((counter++))", "readonly":false, "mutation":null},
  {"name":"unclosed quote not exempted", "command":"firewall-cmd --state; echo 'unfinished", "readonly":false, "mutation":null}
]
