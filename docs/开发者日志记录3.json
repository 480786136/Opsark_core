# 尝试通过设置环境变量和使用特定 compiler plugin 版本来解决兼容性问题
完整返回内容
# 首先检查是否有 JDK 1.8 (Java 8)，它通常与较旧的编译器插件更兼容
if ls -d /usr/lib/jvm/java-1.8.0-openjdk* 2>/dev/null; then
  export JAVA_HOME=$(ls -d /usr/lib/jvm/java-1.8.0-openjdk* | head -n 1)
  export PATH=$JAVA_HOME/bin:$PATH
  echo "Switched to JDK 1.8: $JAVA_HOME"
elif [ -n "$JAVA_HOME" ]; then
  echo "Using existing JAVA_HOME: $JAVA_HOME"
else
  echo "No suitable alternative JDK found, will try updating compiler plugin version in pom.xml"
  # 尝试更新 maven-compiler-plugin 到较新版本以支持当前 JDK 内部 API
  cd /opt/qiwen-file
  sed -i 's/maven-compiler-plugin:3.10.1/maven-compiler-plugin:3.11.0/g' pom.xml
  echo "Updated maven-compiler-plugin version in pom.xml"
fi
echo 'ENV_SETUP_DONE'
