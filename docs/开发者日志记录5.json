log-1788578256911-8ip5eg
执行内容
set -euo pipefail
完整返回内容
REDIS_BIN_DIR="/usr/local/redis/bin"
mkdir -p "$REDIS_BIN_DIR"

# 如果 /usr/local/redis/bin/redis-server 不存在，尝试从 /usr/local/bin 复制
if [ ! -x "$REDIS_BIN_DIR/redis-server" ]; then
    if [ -x "/usr/local/bin/redis-server" ]; then
        echo "Copying redis-server from /usr/local/bin to $REDIS_BIN_DIR"
        cp /usr/local/bin/redis* "$REDIS_BIN_DIR/"
    else
        echo "Redis binaries not found in expected locations. Rebuilding and installing to correct path."
        WORK_DIR=$(mktemp -d)
        cd "$WORK_DIR"
        curl -O https://download.redis.io/releases/redis-7.2.4.tar.gz
        tar xzf redis-7.2.4.tar.gz
        cd redis-7.2.4
        make PREFIX="$REDIS_BIN_DIR/.." > /dev/null 2>&1
        make install PREFIX="$REDIS_BIN_DIR/.." > /dev/null 2>&1
        cd /
        rm -rf "$WORK_DIR"
    fi
fi

# 验证二进制文件存在
if [ ! -x "$REDIS_BIN_DIR/redis-server" ]; then
    echo "ERROR: redis-server still not found at $REDIS_BIN_DIR/redis-server after fix attempt"
    exit 1
fi

# 停止可能存在的旧实例（忽略错误）
$REDIS_BIN_DIR/redis-cli shutdown nosave 2>/dev/null || true
sleep 1

# 启动 redis-server
$REDIS_BIN_DIR/redis-server --daemonize yes
sleep 2

# 验证 PONG
PONG_RESULT=$($REDIS_BIN_DIR/redis-cli ping)
if [ "$PONG_RESULT" != "PONG" ]; then
    echo "ERROR: Redis ping returned '$PONG_RESULT' instead of 'PONG'"
    exit 1
fi
echo "Redis is running and responding with PONG"
