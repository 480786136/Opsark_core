          "content": "{\n  \"tree\": \"/opt/kaifangqian-base/\\n├── kaifangqian-base\\\\.git/\\n├── kaifangqian-base\\\\deploy/\\n├── kaifangqian-base\\\\doc/\\n├── kaifangqian-base\\\\kaifangqian-parent/\\n├── kaifangqian-base\\\\kaifangqian-web/\\n├── kaifangqian-base\\\\.gitignore\\n├── kaifangqian-base\\\\LICENSE\\n└── kaifangqian-base\\\\README.md\",\n  \"rootPath\": \"/opt/kaifangqian-base\",\n  \"truncated\": true,\n  \"warnings\": [\n    \"无法读取远程目录 /opt/kaifangqian-base/kaifangqian-base\\\\.git：[SFTP(2)] no such file\",\n    \"无法读取远程目录 /opt/kaifangqian-base/kaifangqian-base\\\\deploy：[SFTP(2)] no such file\",\n    \"无法读取远程目录 /opt/kaifangqian-base/kaifangqian-base\\\\doc：[SFTP(2)] no such file\",\n    \"无法读取远程目录 /opt/kaifangqian-base/kaifangqian-base\\\\kaifangqian-parent：[SFTP(2)] no such file\",\n    \"无法读取远程目录 /opt/kaifangqian-base/kaifangqian-base\\\\kaifangqian-web：[SFTP(2)] no such file\"\n  ]\n}"
